@echo off
rem DiagLab Pro - lance le rapport de diagnostic en administrateur
net session >nul 2>&1
if %errorlevel% neq 0 (
  echo Demande des droits administrateur...
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0DiagLab-Rapport.ps1" %*
echo.
pause
